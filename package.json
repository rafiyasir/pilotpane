{
  "name": "pilotpane",
  "version": "0.1.0",
  "private": true,
  "description": "Control your Windows laptop from any device with a browser on your local network.",
  "license": "MIT",
  "author": "Rafi Uzzaman",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -b && node scripts/copy-static.mjs",
    "clean": "node scripts/clean.mjs",
    "package": "pnpm build && node scripts/package.mjs",
    "installer": "pnpm build && node scripts/build-installer.mjs",
    "start": "pnpm build && pnpm --filter @pilotpane/host start",
    "test": "pnpm build && node --test \"packages/protocol/dist/**/*.test.js\" \"apps/host/dist/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "~6.0.3"
  }
}
